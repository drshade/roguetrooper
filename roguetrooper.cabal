cabal-version: 2.4
name:          roguetrooper
version:       0.1.0.0
build-type:    Simple
synopsis:      Paratrooper x Vampire Survivors arcade roguelite (Haskell + Raylib)

library
  hs-source-dirs:   src
  default-language: GHC2024
  default-extensions:
    DataKinds
    DeriveGeneric
    DuplicateRecordFields
    GADTs
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    PatternSynonyms
    RecordWildCards
    TemplateHaskell
    TypeApplications
    TypeFamilies
    TypeOperators

  ghc-options: -Wall
  exposed-modules:
    Prelude
    RogueTrooper
    RogueTrooper.Aim
    RogueTrooper.Behaviours
    RogueTrooper.Behaviours.Common
    RogueTrooper.Behaviours.Enemy
    RogueTrooper.Behaviours.Mission
    RogueTrooper.Behaviours.Weapon
    RogueTrooper.Engine
    RogueTrooper.Script
    RogueTrooper.Types

  build-depends:
    containers,
    free,
    h-raylib,
    rerebase,

  mixins:
    rerebase (Prelude as RerebasePrelude),
    rerebase hiding (Prelude)

executable roguetrooper
  hs-source-dirs:   app
  main-is:          Main.hs
  default-language: GHC2024
  default-extensions:
    OverloadedRecordDot
    OverloadedStrings
    PatternSynonyms

  ghc-options:
    -Wall
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    roguetrooper,
    rerebase,

  mixins:
    rerebase hiding (Prelude)

test-suite roguetrooper-test
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  default-language: GHC2024
  default-extensions:
    OverloadedRecordDot
    OverloadedStrings
    PatternSynonyms

  ghc-options:
    -Wall
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    containers,
    free,
    h-raylib,
    hspec,
    rerebase,
    roguetrooper,

  mixins:
    rerebase hiding (Prelude)
